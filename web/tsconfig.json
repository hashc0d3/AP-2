{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    // Неиспользуемые переменные и импорты — след незакончённой правки.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Обращение к элементу массива может вернуть undefined.
    "noUncheckedIndexedAccess": true,
    // Каждая ветка switch обязана возвращать значение.
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // Поля с необязательным типом нельзя присвоить undefined неявно.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src"]
}
