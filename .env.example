# Секреты и параметры окружения. Скопируйте в .env и заполните.
# Файл .env в git не попадает (см. .gitignore). Всё, что не является
# секретом, настраивается в config.toml.

# ── Мобильный прокси (обязательно) ──────────────────────────────────
# Строка подключения к мобильному прокси: через него идут запросы к Avito.
PROXY_STRING=user:pass@mproxy.site:20085
# Ссылка смены IP у оператора прокси. Вызывается, когда Avito начинает
# отвечать отказами — обычно этого достаточно, чтобы продолжить работу.
PROXY_CHANGE_URL=https://aproxy.site/?proxy_key=YOUR_KEY
# Второй прокси (необязательно, но заметно быстрее): наборы cookies
# делятся между каналами, поэтому на каждый IP приходится вдвое меньше
# запросов. Забаненный канал меняет адрес в фоне, его наборы уходят к соседу.
# PROXY_STRING_2=user:pass@mproxy.site:10341
# PROXY_CHANGE_URL_2=https://aproxy.site/?proxy_key=YOUR_SECOND_KEY
# Третий прокси — так же необязателен. Наборы делятся уже на три канала.
# PROXY_STRING_3=user:pass@mproxy.site:26101
# PROXY_CHANGE_URL_3=https://aproxy.site/?proxy_key=YOUR_THIRD_KEY

# ── Сервис cookies spfa.pro (обязательно) ───────────────────────────
# Ключ API: покупка cookies, разблокировка и проверка баланса.
COOKIES_API_KEY=sk_live_YOUR_KEY

# ── Вход в веб-интерфейс (обязательно) ──────────────────────────────
# ОБЯЗАТЕЛЬНО смените пароль: со значением по умолчанию приложение
# выводит предупреждение при каждом запуске.
APP_LOGIN=admin
APP_PASSWORD=change_me
# Сколько дней живёт сессия браузера (по умолчанию 30).
# SESSION_TTL_DAYS=30

# ── Сервер ──────────────────────────────────────────────────────────
# Порт веб-интерфейса.
WEB_PORT=8765
# Адрес прослушивания. 127.0.0.1 — только локально (значение по
# умолчанию), 0.0.0.0 — нужно в Docker.
WEB_HOST=127.0.0.1
# Открывать браузер при запуске: 1 — да (удобно локально), 0 — нет.
WEB_OPEN_BROWSER=1
# Продакшен: обслуживать только свой домен, чтобы к интерфейсу нельзя
# было обратиться по IP в обход nginx и TLS. Локальные адреса
# разрешены всегда — на них ходит healthcheck.
# ALLOWED_HOST=monitor.example.com

# ── Windows ─────────────────────────────────────────────────────────
# 1 — не менять таблицу маршрутов при старте. Обход VPN нужен только на
# Windows-машине с включённым VPN; в Docker и на Linux игнорируется.
SKIP_VPN_BYPASS=1

# ── Push-уведомления (необязательно) ────────────────────────────────
# Ключи VAPID создаются командой:
#   python -m avito_monitor.tools.generate_vapid
# Приватный ключ по умолчанию лежит в storage/vapid_private.pem.
# Переменные ниже нужны, только если ключи хранятся не в файлах.
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# Контакт для сервиса push (требование стандарта Web Push).
# VAPID_CONTACT=mailto:admin@example.com
