# Прокси и доступ к ресурсу cookies
PROXY_STRING=user:pass@mproxy.site:20085
SOCKS5_PROXY=user:pass@bproxy.site:20085
PROXY_CHANGE_URL=https://aproxy.site/?proxy_key=YOUR_KEY
COOKIES_API_KEY=sk_live_YOUR_KEY

# Вход в веб-интерфейс
APP_LOGIN=admin
APP_PASSWORD=change_me

# Сервер (Docker подхватывает автоматически)
WEB_PORT=8765
WEB_HOST=0.0.0.0
WEB_OPEN_BROWSER=0
SKIP_VPN_BYPASS=1

# Продакшен: только через домен (localhost — для healthcheck)
# ALLOWED_HOST=peterparser.ru

# Web Push (python tools/generate_vapid.py)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:admin@peterparser.ru
