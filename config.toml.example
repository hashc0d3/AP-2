[avito]
# Поиск по умолчанию (можно сменить в веб-интерфейсе)
url = "https://www.avito.ru/all/telefony?owner[]=private&s=104"
api_url = "https://www.avito.ru/web/1/js/items?categoryId=84&owner%5B0%5D=private&presentationType=serp&privateOnly=1&sort=date"

# Секреты — в .env (PROXY_STRING, COOKIES_API_KEY и т.д.)

ignore_promotion = true
seller_skip = ["re:premium"]
max_age = 300
notify_max_age = 0
pages = 1
pause_between_pages = 2
title_must_contain = []
title_skip = ["книга", "книг", "журнал", "комикс", "чехол", "кабель", "зарядк"]
iphone_min_model = 0    # фильтр моделей — в настройках поиска (шестерёнка)
iphone_max_model = 0

# Скорость опроса
poll_interval = 4
poll_interval_max = 24
per_cookie_interval = 12
request_timeout = 10
ip_change_wait = 12
pause_general = 12
pause_max = 40
cookie_pool_size = 5
cookie_unblock_pause = 60
web_port = 8765
