# Поведение парсера. Скопируйте файл в config.toml и правьте под задачу.
# Секреты сюда не попадают — они живут в .env (см. .env.example).
#
# Все значения необязательные: пропущенный ключ берётся из значений по
# умолчанию, а незнакомый ключ пишется в лог и игнорируется. Полный список
# ключей с пояснениями — docs/configuration.md.

[avito]

# ── Что показывать ──────────────────────────────────────────────────

# Скрывать платно продвинутые объявления. Avito поднимает их в выдаче
# повторно, и по дате публикации они выглядят как новые.
ignore_promotion = true

# Только частные объявления, без магазинов и брендов.
private_only = true

# Чёрный список продавцов: подстроки в имени или ссылке на профиль.
# Сравнение без учёта регистра, пробелов и знаков, поэтому «премиум»
# поймает и «П Р Е М И У М . Store». Дополняется из интерфейса.
seller_skip = []

# Объявление должно содержать в названии хотя бы одно из слов.
# Пустой список — не проверять.
title_must_contain = []

# Объявление не показывается, если в названии есть любое из слов.
title_skip = ["книга", "книг", "журнал", "комикс", "чехол", "кабель", "зарядк"]

# Максимальный возраст объявления на Avito, секунды. 1200 — 20 минут.
# 0 — без ограничения.
max_age = 1200

# Не показывать объявление, если к моменту попадания в ленту оно старше
# N секунд. Страховка от всплеска задержек. 0 — выключено.
notify_max_age = 0

# ── Фильтр моделей iPhone ───────────────────────────────────────────
# Обычно задаётся в интерфейсе (шестерёнка рядом с категорией) — там
# фильтр уходит прямо в ссылку Avito и работает точнее.
# Здесь — только нижняя и верхняя границы поколения по названию.
# 0 — не ограничивать.
iphone_min_model = 0
iphone_max_model = 0

# Список конкретных моделей. Пусто/не задано — фильтр выключен.
# Идентификаторы: "13", "13-pro", "16-e", "17-air" (см. интерфейс).
# Одно число означает всю линейку: [13] = все варианты 13-й.
# iphone_models = ["16-pro", "16-pro-max", "17-pro"]

# ── Страницы выдачи ─────────────────────────────────────────────────

# Сколько страниц максимум читать за цикл. По умолчанию только первая.
# Если поставить 2 — вторую берём только когда на первой нет подходящих.
pages = 1

# Пауза между страницами, секунды.
pause_between_pages = 2

# ── Темп опроса ─────────────────────────────────────────────────────
# Интервал плавает между poll_interval и poll_interval_max: на серии
# отказов Avito парсер замедляется, на серии чистых циклов — ускоряется.
# Слишком агрессивные значения быстро сожгут пул cookies.

poll_interval = 4
poll_interval_max = 24

# Как часто допустимо использовать один набор cookies, секунды.
# Фактический интервал не бывает чаще, чем per_cookie_interval / размер пула.
per_cookie_interval = 12

# Таймаут запроса к Avito, секунды. 10 мало для медленного мобильного прокси.
request_timeout = 20

# Сколько ждать после команды смены IP, секунды.
ip_change_wait = 25

# Пауза после неудачного цикла, секунды.
retry_pause = 12

# ── Пул cookies ─────────────────────────────────────────────────────

# Сколько наборов cookies держать наготове. Больше наборов — чаще опрос,
# но выше расход средств на сервисе.
cookie_pool_size = 5

# Пауза перед повторной разблокировкой набора, секунды.
cookie_unblock_pause = 60

# ── Веб-интерфейс ───────────────────────────────────────────────────
# Переменная окружения WEB_PORT, если задана, важнее этого значения.
web_port = 8765
